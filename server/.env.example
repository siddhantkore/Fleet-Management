# ==================== DATABASE CONFIGURATION ====================
# Connection string for PostgreSQL database
# Format: postgresql://username:password@host:port/database
# For Docker Compose: Use service name 'db' as host
# For Local: Use 'localhost' as host
DATABASE_URL=postgresql://fleet_user:fleet_password@db:5432/fleet_management

# ==================== APPLICATION SETTINGS ====================

# Debug mode - Enable for development, disable for production
# When True: Shows detailed error pages, enables auto-reload
DEBUG=True

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ==================== FUTURE: AUTHENTICATION ====================
# Secret key for JWT token signing (generate a random string in production)
# SECRET_KEY=your-secret-key-here

# ==================== SMS NOTIFICATIONS (Twilio) ====================
# Automatically sends trip assignment SMS to drivers when a trip is created.
# Get credentials at https://www.twilio.com/console
# Leave blank to disable SMS (the system will still function without it).
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+12015550123   # Your Twilio phone number in E.164 format

# ==================== FUTURE: API KEYS ====================
# API keys for external services
# GOOGLE_API_KEY=your-google-api-key

# ==================== FUTURE: CACHE ====================
# Redis connection for caching and sessions
# REDIS_URL=redis://cache:6379

# ==================== FUTURE: EMAIL ====================
# SMTP email configuration for notifications
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
